generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          String    @default("STUDENT") // STUDENT, INSTRUCTOR, ADMIN
  xp            Int       @default(0)
  level         Int       @default(1)
  streakDays    Int       @default(0)
  lastActiveAt  DateTime  @default(now())
  avatarUrl     String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  progress         UserProgress[]
  achievements     UserAchievement[]
  labSessions      LabSession[]
  auditLogs        AuditLog[]
  forumPosts       ForumPost[]
  forumComments    ForumComment[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningPath {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  category    String   // Web, SOC, Network, Linux, CTF, Cloud
  icon        String   @default("shield")
  difficulty  String   // BEGINNER, INTERMEDIATE, ADVANCED
  order       Int      @default(1)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  courses Course[]
}

model Course {
  id               String       @id @default(uuid())
  learningPathId   String
  title            String
  slug             String       @unique
  description      String
  difficulty       String       @default("BEGINNER")
  estimatedMinutes Int          @default(60)
  icon             String       @default("book-open")
  order            Int          @default(1)
  published        Boolean      @default(true)
  createdAt        DateTime     @default(now())

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  modules      Module[]
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String
  order       Int      @default(1)
  createdAt   DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id                String   @id @default(uuid())
  moduleId          String
  title             String
  slug              String   @unique
  type              String   @default("THEORY") // THEORY, LAB, QUIZ, FLASHCARD
  contentMarkdown   String
  cheatSheet        String?
  xpReward          Int      @default(50)
  order             Int      @default(1)
  createdAt         DateTime @default(now())

  module   Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  labs     Lab[]
  progress UserProgress[]
}

model Lab {
  id            String   @id @default(uuid())
  lessonId      String
  title         String
  description   String
  difficulty    String   @default("EASY")
  flagsJson     String   // JSON string of encrypted/hashed flags
  hintsJson     String   // JSON string of hints and XP cost
  containerImage String?
  portsJson     String?  // JSON string of port mappings
  createdAt     DateTime @default(now())

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  labSessions LabSession[]
}

model LabSession {
  id           String    @id @default(uuid())
  userId       String
  labId        String
  status       String    @default("RUNNING") // RUNNING, STOPPED, COMPLETED
  containerId  String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  score       Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  badgeIcon   String
  xpReward    Int      @default(100)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   // MITRE, OWASP, CVE, CAPEC, NIST, MAN
  referenceId String?  // e.g. T1059, CVE-2023-34048
  content     String
  tagsJson    String   @default("[]")
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ForumPost {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  category  String   @default("General")
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments ForumComment[]
}

model ForumComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
